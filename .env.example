# Telegram BotFather 返回的 Token。不要提交或公开这个值。
TELEGRAM_BOT_TOKEN=

# 频道：将 Bot 设为频道管理员并发一条频道消息后，通过 discover-chat 获取；
# 公开频道也可填写 @频道用户名。
TELEGRAM_CHAT_ID=

# 第一阶段生产模式要求 DeepSeek；本地测试可保持 rules。
AI_MODE=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
PROMPT_VERSION=local-v2
USER_PROMPT_PATH=config/prompts/intelligence_filter_user.md
LANGFUSE_ENABLED=false
LANGFUSE_HOST=https://cloud.langfuse.com
# 自建 Langfuse 可使用 LANGFUSE_BASE_URL；它优先于 LANGFUSE_HOST。
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_PROMPT_NAME=ai-intelligence-filter
LANGFUSE_PROMPT_LABEL=production
LANGFUSE_CACHE_SECONDS=60
DIGEST_PROMPT_VERSION=local-v1
DIGEST_PROMPT_PATH=config/prompts/digest_summary.md
DIGEST_USER_PROMPT_PATH=config/prompts/digest_summary_user.md
LANGFUSE_DIGEST_PROMPT_NAME=ai-intelligence-digest
LANGFUSE_DIGEST_PROMPT_LABEL=production
DEDUP_PROMPT_VERSION=local-v1
DEDUP_PROMPT_PATH=config/prompts/intelligence_dedup.md
DEDUP_USER_PROMPT_PATH=config/prompts/intelligence_dedup_user.md
LANGFUSE_DEDUP_PROMPT_NAME=ai-intelligence-dedup
LANGFUSE_DEDUP_PROMPT_LABEL=production
DEDUP_MIN_CONFIDENCE=0.80
AI_EMAIL_USERNAME=
AI_EMAIL_PASSWORD=
X_BEARER_TOKEN=
CREATOR_X_URL=https://x.com/axe0x0
WORKER_TICK_SECONDS=15

# 私有模板管理 API 的 Bearer Token。请使用至少 32 字节的随机值。
# 生成示例：python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_TOKEN=
RUNTIME_DB_PATH=data/runtime.db
